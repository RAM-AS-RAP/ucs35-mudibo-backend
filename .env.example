APP_ENV=development
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=listing-images
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
# Roles that must enter an emailed code after the password (comma list of farmer, buyer, admin).
# Production refuses a list without admin. Roles not listed sign in with the password alone.
LOGIN_OTP_ROLES=farmer,buyer,admin
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CHALLENGE_TTL_MINUTES=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_SENDS=3
LOGIN_RESEND_COOLDOWN_SECONDS=60
LOGIN_CHALLENGES_PER_HOUR=10
# Farmer and buyer registration confirmed by an emailed code.
REG_TTL_MINUTES=60
REG_CODE_TTL_MINUTES=15
REG_MAX_ATTEMPTS=5
REG_MAX_SENDS=5
REG_RESEND_COOLDOWN_SECONDS=60
REG_EXISTS_NOTICE_MINUTES=10
# Google sign in for farmers and buyers (see docs/google-setup.md). Empty disables it: the Google
# routes answer 503 google_unavailable. When set it must end with .apps.googleusercontent.com.
GOOGLE_CLIENT_ID=
GOOGLE_NONCE_TTL_SECONDS=300
GOOGLE_SIGNUP_TTL_MINUTES=10
GOOGLE_JWKS_CACHE_SECONDS=3600
GOOGLE_CLOCK_SKEW_SECONDS=60
GOOGLE_MAX_TOKEN_AGE_SECONDS=900
MPESA_ENV=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=
MPESA_CALLBACK_TOKEN=
# entered (the number the buyer enters when paying), test_msisdn (every prompt to MPESA_TEST_MSISDN),
# or registered (a deprecated alias of entered).
MPESA_STK_TARGET=entered
MPESA_TEST_MSISDN=254708374149
MPESA_MAX_ATTEMPTS_PER_ORDER=3
MPESA_MIN_SECONDS_BEFORE_EXPIRY=90
MPESA_STALE_INITIATING_SECONDS=60
MPESA_PHONE_ATTEMPTS_PER_HOUR=5
MPESA_BUYER_ATTEMPTS_PER_HOUR=10
MPESA_BUYER_DISTINCT_PHONES_PER_DAY=3
MPESA_QUERY_MIN_INTERVAL_SECONDS=20
MPESA_TIMEOUT_RECONCILE_WINDOW_MINUTES=15
MPESA_TRANSACTION_DESC=Crop order
CALLBACK_MAX_BYTES=16384
RESOLVE_NOTE_MIN_LENGTH=10
ORDER_EXPIRY_MINUTES=5
RECONCILE_AFTER_SECONDS=90
MAX_IMAGE_BYTES=5242880
MAX_ACTIVE_LISTINGS_PER_FARMER=50
IMAGE_MAX_DIMENSION=1600
IMAGE_JPEG_QUALITY=85
MIN_ORDER_QUANTITY=1
MIN_ORDER_TOTAL_KES=10
MAX_PENDING_ORDERS_PER_BUYER=3
ORDER_REFERENCE_LENGTH=8
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# scripts/seed_demo_data.py: you@gmail.com gives demo addresses like you+demo-farmer1@gmail.com.
DEMO_EMAIL_BASE=
# Protects every email code (registration, sign in, invites, password resets). The name is historical.
INVITE_CODE_PEPPER=
INVITE_TTL_DAYS=7
INVITE_CODE_TTL_MINUTES=15
INVITE_MAX_ATTEMPTS=10
INVITE_MAX_SENDS=5
