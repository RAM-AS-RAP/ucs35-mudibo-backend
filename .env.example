EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
FRONTEND_BASE_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
